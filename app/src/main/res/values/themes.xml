<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose draws the whole UI, so this only needs to avoid an action bar and paint the
      window the same colour as the Compose background. Colours/typography live in ui/theme.
      Bars are transparent because MainActivity calls enableEdgeToEdge() - on Android 15+
      (targetSdk 35+) edge-to-edge is enforced anyway.
    -->
    <style name="Theme.Blackout" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
