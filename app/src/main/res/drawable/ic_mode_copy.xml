<!--
  Two overlapping sheets - the standard copy mark.

  The back sheet is drawn as an outline stroke rather than a filled shape with a hole punched in
  it, so there is no nested-subpath winding to get wrong.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">

    <!-- back sheet, outlined -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.55"
        android:strokeWidth="1.6"
        android:fillColor="#00000000"
        android:pathData="M4.8,15.2 h-0.4 a1.6,1.6 0 0 1 -1.6,-1.6 v-8.4 a1.6,1.6 0 0 1 1.6,-1.6 h8.4 a1.6,1.6 0 0 1 1.6,1.6 v0.4" />

    <!-- front sheet, outlined -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8"
        android:fillColor="#00000000"
        android:pathData="M10.4,8 h8.4 a1.8,1.8 0 0 1 1.8,1.8 v8.4 a1.8,1.8 0 0 1 -1.8,1.8 h-8.4 a1.8,1.8 0 0 1 -1.8,-1.8 v-8.4 a1.8,1.8 0 0 1 1.8,-1.8 z" />
</vector>
