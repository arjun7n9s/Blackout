<!--
  A page with one line blacked out.

  Separate <path> elements rather than one path with subpaths: nonZero winding fills the whole
  outline solid when subpaths are nested, which is how the launcher icons first came out as
  plain squares.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">

    <!-- top text line -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.55"
        android:pathData="M4,5.5 h16 a0.9,0.9 0 0 1 0,1.8 h-16 a0.9,0.9 0 0 1 0,-1.8 z" />

    <!-- the redaction bar: solid, full opacity, deliberately the heaviest mark -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4,10.4 h16 a1.3,1.3 0 0 1 0,2.6 h-16 a1.3,1.3 0 0 1 0,-2.6 z" />

    <!-- bottom text line, short -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.55"
        android:pathData="M4,16.2 h10 a0.9,0.9 0 0 1 0,1.8 h-10 a0.9,0.9 0 0 1 0,-1.8 z" />
</vector>
