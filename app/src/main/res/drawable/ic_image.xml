    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.9"
        android:pathData="M5.2,4.2 L18.8,4.2 A2,2 0 0 1 20.8,6.2 L20.8,17.8 A2,2 0 0 1 18.8,19.8 L5.2,19.8 A2,2 0 0 1 3.2,17.8 L3.2,6.2 A2,2 0 0 1 5.2,4.2 Z" />

    <!-- sun -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M8.6,8.6 m-1.75,0 a1.75,1.75 0 1,0 3.5,0 a1.75,1.75 0 1,0 -3.5,0" />

    <!-- ridge -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M4.6,17.6 L9.6,11.4 L13.1,15.6 L15.6,12.9 L19.4,17.6 Z" />

</vector>
